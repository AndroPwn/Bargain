# ── Postgres ──────────────────────────────────
POSTGRES_USER=ecoloop
POSTGRES_PASSWORD=ecoloop_secret
POSTGRES_DB=ecoloop

# ── Server ────────────────────────────────────
NODE_ENV=development
JWT_SECRET=change_this_to_a_long_random_string
SERVER_URL=http://localhost:3001
DATABASE_URL=postgres://ecoloop:ecoloop_secret@localhost:5432/ecoloop

# ── Dev Mode (set true to skip OTP) ──────────
DEV_MODE=true

# ── Twilio (only needed when DEV_MODE=false) ──
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Email OTP (needed when DEV_MODE=false) ────
EMAIL_USER=your_sender_gmail@example.com
EMAIL_PASS=your_gmail_app_password

# ── NVIDIA NIM AI keys ────────────────────────
NVIDIA_API_KEY=nvapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_API_KEY_MATCH=nvapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Client ────────────────────────────────────
VITE_API_URL=http://localhost:3001
