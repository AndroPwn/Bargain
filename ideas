        const earned = Math.round(baseKarma * minMultiplier);
        await client.query(
          "INSERT INTO karma_events (user_id, delta, reason, match_id) VALUES ($1,$2,$3,$4)",
          [p.user_id, earned, matchType === "one_to_one" ? "direct_swap" : "circular_trade", req.params.id]
        );
        await client.query("UPDATE users SET karma = karma + $1 WHERE id = $2", [earned, p.user_id]);
      }

      // Update trade pair counts for anti-farming
      for (let i = 0; i < participants.length; i++) {
        for (let j = i + 1; j < participants.length; j++) {
          const [a, b] = pairKey(participants[i].user_id, participants[j].user_id);
          await client.query(
            `INSERT INTO trade_pairs (user_a, user_b, trade_count) VALUES ($1,$2,1)
             ON CONFLICT (user_a, user_b) DO UPDATE SET trade_count = trade_pairs.trade_count + 1`,
            [a, b]
          );
        }
      }
    }

    await client.query("COMMIT");
    res.json({ allConfirmed });
  } catch (e) {
    await client.query("ROLLBACK");
    res.status(500).json({ error: e.message });
  } finally {
    client.release();
  }
});

