router.post("/run", requireAuth, async (req, res) => {
  // Get the requesting user's geohash for local filtering
  const { rows: [me] } = await pool.query("SELECT geohash FROM users WHERE id = $1", [req.user.id]);

  const { rows: candidates } = await pool.query(
    `SELECT u.id, u.karma, u.geohash, u.display_name,
            l.id AS listing_id, l.category AS listing_category,
            w.category AS want_category
     FROM users u
     JOIN listings l ON l.user_id = u.id AND l.status = 'active'
     JOIN wants w ON w.user_id = u.id AND w.is_active = TRUE`
  );

  // Filter to local area only
  const local = candidates.filter(c => withinRadius(c.geohash, me?.geohash));

  // Load swipe counts for all local listing IDs
  const listingIds = [...new Set(local.map(c => c.listing_id))];
  let swipeCounts = {};
  if (listingIds.length > 0) {
    const { rows: swipes } = await pool.query(
      `SELECT listing_id, COUNT(*) AS cnt FROM swipe_wants WHERE listing_id = ANY($1) GROUP BY listing_id`,
      [listingIds]
    );
    swipes.forEach(s => { swipeCounts[s.listing_id] = parseInt(s.cnt); });
  }

  const matchInput = local.map(c => ({
    id: c.id,
    karma: c.karma,
    displayName: c.display_name,
    listingId: c.listing_id,
    listingCategory: c.listing_category,
    wantCategory: c.want_category,
    swipeBoost: swipeCounts[c.listing_id] || 0,
  }));

  const matches = findCircularMatches(matchInput);
  const myMatches = matches.filter(chain => chain.some(u => u.id === req.user.id));
  res.json({ matches: myMatches });
});

