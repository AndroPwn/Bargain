// Rough geohash encoder (precision 5, ~4.9km cells) — no dependency needed
function encodeGeohash(lat, lng, precision = 5) {
  const BASE32 = '0123456789bcdefghjkmnpqrstuvwxyz'
  let minLat = -90, maxLat = 90, minLng = -180, maxLng = 180
  let hash = '', bits = 0, bitsTotal = 0, hashValue = 0
  while (hash.length < precision) {
    if (bitsTotal % 2 === 0) {
      const mid = (minLng + maxLng) / 2
      if (lng >= mid) { hashValue = (hashValue << 1) + 1; minLng = mid }
      else            { hashValue = (hashValue << 1) + 0; maxLng = mid }
    } else {
      const mid = (minLat + maxLat) / 2
      if (lat >= mid) { hashValue = (hashValue << 1) + 1; minLat = mid }
      else            { hashValue = (hashValue << 1) + 0; maxLat = mid }
    }
    bitsTotal++
    if (++bits === 5) { hash += BASE32[hashValue]; bits = 0; hashValue = 0 }
  }
  return hash
}

