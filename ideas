// ─────────────────────────────────────────────
// EcoLoop — Trust Engine + Matching Algorithm
// ─────────────────────────────────────────────

// Karma awarded ONLY when a trade is fully confirmed by all parties
export const KARMA = {
  DIRECT_SWAP:  20,   // 1:1 confirmed trade
  CIRCULAR:     40,   // 3-way+ circle
  NGO_DONATION: 60,   // donate to NGO
  FOOD_SURPLUS: 20,   // food listing claimed
  NO_SHOW:     -50,
  MISREP:      -30,
};

// Anti-farming: >2 completed trades between same pair = 90% karma reduction
export function karmaMultiplier(completedTradesBetweenPair) {
  return completedTradesBetweenPair > 2 ? 0.1 : 1.0;
}

// Geohash precision 5 ≈ 4.9km cell
export function withinRadius(geohashA, geohashB, precision = 5) {
  if (!geohashA || !geohashB) return false;
  return geohashA.slice(0, precision) === geohashB.slice(0, precision);
}

export function rankRequesters(requesters) {
  return [...requesters].sort((a, b) => b.karma - a.karma);
}

// Find 1:1 and 3-way circular exchange loops
// users: [{ id, karma, listingId, listingCategory, wantCategory, swipeBoost? }]
export function findCircularMatches(users) {
  const matches = [];

  function canGiveTo(giver, receiver) {
    return giver.listingCategory === receiver.wantCategory;
  }

  function scoreChain(chain) {
    return chain.reduce((sum, u) => sum + (u.karma || 0) + (u.swipeBoost || 0) * 50, 0);
  }

  for (let i = 0; i < users.length; i++) {
    for (let j = 0; j < users.length; j++) {
      if (i === j) continue;

      // 1:1
      if (canGiveTo(users[i], users[j]) && canGiveTo(users[j], users[i])) {
        const already = matches.some(
          (m) => m.length === 2 && m.includes(users[i]) && m.includes(users[j])
        );
        if (!already) matches.push([users[i], users[j]]);
        continue;
      }

      // 3-way circular
      for (let k = 0; k < users.length; k++) {
        if (k === i || k === j) continue;
        if (
          canGiveTo(users[i], users[j]) &&
          canGiveTo(users[j], users[k]) &&
          canGiveTo(users[k], users[i])
        ) {
          const set = new Set([users[i].id, users[j].id, users[k].id]);
          const already = matches.some(
            (m) => m.length === 3 && m.every((u) => set.has(u.id))
          );
          if (!already) matches.push([users[i], users[j], users[k]]);
        }
      }
    }
  }

  // Best matches (highest karma + swipe boosts) first
  return matches.sort((a, b) => scoreChain(b) - scoreChain(a));
}

export function scoreMatch(chain) {
  return chain.reduce((sum, u) => sum + (u.karma || 0), 0);
}

// Pair key for anti-farming (always lower UUID first)
export function pairKey(userIdA, userIdB) {
  return userIdA < userIdB ? [userIdA, userIdB] : [userIdB, userIdA];
}
