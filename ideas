router.post("/", requireAuth, async (req, res) => {
  const { chain } = req.body;
  if (!chain || chain.length < 2) return res.status(400).json({ error: "chain must have at least 2 participants" });

  const client = await pool.connect();
  try {
    await client.query("BEGIN");
    const matchType = chain.length === 2 ? "one_to_one" : "circular";
    const { rows: [match] } = await client.query("INSERT INTO matches (match_type) VALUES ($1) RETURNING *", [matchType]);

    const participantIds = [];
    for (const member of chain) {
      const { rows: [p] } = await client.query(
        "INSERT INTO match_participants (match_id, user_id, listing_id) VALUES ($1,$2,$3) RETURNING id",
        [match.id, member.id, member.listingId]
      );
      participantIds.push(p.id);
    }

    // Set circular receives_from pointers
    for (let i = 0; i < participantIds.length; i++) {
      const receivesFrom = participantIds[(i - 1 + participantIds.length) % participantIds.length];
      await client.query("UPDATE match_participants SET receives_from = $1 WHERE id = $2", [receivesFrom, participantIds[i]]);
    }

    for (const member of chain) {
      await client.query("UPDATE listings SET status = 'matched' WHERE id = $1", [member.listingId]);
    }

    await client.query("COMMIT");
    res.status(201).json({ match, participantCount: chain.length });
  } catch (e) {
    await client.query("ROLLBACK");
    res.status(500).json({ error: e.message });
  } finally {
    client.release();
  }
});

// Confirm your side of the trade — karma ONLY awarded here when all confirm
router.post("/:id/confirm", requireAuth, async (req, res) => {
  const client = await pool.connect();
  try {
    await client.query("BEGIN");
    await client.query(
      "UPDATE match_participants SET confirmed = TRUE WHERE match_id = $1 AND user_id = $2",
      [req.params.id, req.user.id]
    );

    const { rows: participants } = await client.query(
      `SELECT mp.*, m.match_type FROM match_participants mp
       JOIN matches m ON m.id = mp.match_id
       WHERE mp.match_id = $1`, [req.params.id]
    );
    const allConfirmed = participants.every(p => p.confirmed);

    if (allConfirmed) {
      await client.query("UPDATE matches SET status = 'all_confirmed' WHERE id = $1", [req.params.id]);
      await client.query("UPDATE match_participants SET phone_revealed = TRUE WHERE match_id = $1", [req.params.id]);

      const matchType = participants[0].match_type;
      const baseKarma = matchType === "one_to_one" ? KARMA.DIRECT_SWAP : KARMA.CIRCULAR;

      // Award karma with anti-farming multiplier per pair
      for (const p of participants) {
        // Check how many times this user has traded with each counterpart
        let minMultiplier = 1.0;
        for (const other of participants) {
          if (other.user_id === p.user_id) continue;
          const [a, b] = pairKey(p.user_id, other.user_id);
          const { rows: [pair] } = await client.query(
            "SELECT trade_count FROM trade_pairs WHERE user_a = $1 AND user_b = $2",
